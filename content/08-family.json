  "title": "People and family",
  "tip": "Gujarati has a separate word for almost every relative, depending on which side of the family they're on. Elders get the respectful plural: મારા દાદા, not મારો દાદા.",
  "lessons": [
    { "id": "u08-l1", "title": "Parents and siblings", "items": ["w-mammee", "w-pappaa", "w-bhaai", "w-bahen", "w-parivaar"], "translit": "show" },
    { "id": "u08-l2", "title": "Grandparents", "items": ["w-daadaa", "w-daadee", "w-naanaa", "w-naanee", "x-my-grandfather"], "translit": "hint" },
    { "id": "u08-l3", "title": "Aunts, uncles, children", "items": ["w-kaakaa", "w-maamaa", "w-maasee", "w-phoee", "w-deekaro", "w-deekaree"], "translit": "hint" },
    { "id": "u08-l4", "title": "I, you, big, small", "items": ["w-hun", "w-tun", "w-tame", "w-te", "w-ame", "w-moTo", "w-naano", "x-brother-older", "x-sister-younger"], "translit": "hint" }
  ],
  "items": [
    { "id": "w-mammee", "type": "word", "gujarati": "મમ્મી", "translit": "mammee", "english": "mom", "notes": "The more traditional word is મા (maa)." },

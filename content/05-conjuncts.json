    { "id": "w-mitra", "type": "word", "gujarati": "મિત્ર", "translit": "mitra", "english": "friend", "notes": "ત્ર is ત + ર. A ર after another consonant becomes a small slanted stroke." },
    { "id": "w-prem", "type": "word", "gujarati": "પ્રેમ", "translit": "prem", "english": "love" },

    { "id": "x-this-shop-cheap", "type": "sentence", "gujarati": "આ દુકાન સસ્તી છે.", "translit": "aa dukaan sastee chhe.", "english": "This shop is cheap.", "notes": "સસ્તી, not સસ્તું: દુકાન is feminine." },

    { "id": "w-aDhaar", "type": "word", "gujarati": "અઢાર", "translit": "aDhaar", "english": "eighteen", "notes": "In digits: ૧૮." },
    { "id": "w-ogNees", "type": "word", "gujarati": "ઓગણીસ", "translit": "ogNees", "english": "nineteen", "notes": "In digits: ૧૯. Literally \"one short of twenty\" (વીસ)." },

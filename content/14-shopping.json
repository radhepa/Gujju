    { "id": "x-milk-twenty-five-rupees", "type": "sentence", "gujarati": "આ દૂધ પચીસ રૂપિયાનું છે.", "translit": "aa doodh pachees roopiyaanun chhe.", "english": "This milk is twenty-five rupees.", "alts": ["This milk is 25 rupees", "This milk costs twenty-five rupees", "This milk costs 25 rupees"], "notes": "નું, because દૂધ is neuter." },

    { "id": "w-keTlaanun", "type": "word", "gujarati": "કેટલાનું", "translit": "keTlaanun", "english": "how much (price, neuter)", "notes": "Literally \"of how much\". It matches the thing: કેટલાનું (neuter), કેટલાની (feminine), કેટલાનો (masculine)." },
    { "id": "w-monghun", "type": "word", "gujarati": "મોંઘું", "translit": "monghun", "english": "expensive", "notes": "Agrees like other adjectives: મોંઘો, મોંઘી, મોંઘું." },
    { "id": "w-sastun", "type": "word", "gujarati": "સસ્તું", "translit": "sastun", "english": "cheap", "notes": "Agrees like other adjectives: સસ્તો, સસ્તી, સસ્તું." },
    { "id": "w-ochhun", "type": "word", "gujarati": "ઓછું", "translit": "ochhun", "english": "less, too little" },
    { "id": "w-thoDun", "type": "word", "gujarati": "થોડું", "translit": "thoDun", "english": "a little", "notes": "With a feminine word it is થોડી: થોડી ચા." },
    { "id": "x-how-much-is-this", "type": "sentence", "gujarati": "આ કેટલાનું છે?", "translit": "aa keTlaanun chhe?", "english": "How much is this?" },
    { "id": "x-bring-price-down", "type": "sentence", "gujarati": "થોડું ઓછું કરો.", "translit": "thoDun ochhun karo.", "english": "Bring the price down a little.", "alts": ["Bring it down a little", "Make it a little less", "Reduce it a little", "Lower the price a little", "Bring down the price a little"], "notes": "The usual way to bargain. Literally \"make (it) a little less\"; કરો is the polite \"do\"." },

    { "id": "w-kilo", "type": "word", "gujarati": "કિલો", "translit": "kilo", "english": "kilo", "notes": "એક કિલો, બે કિલો: it does not change." },
    { "id": "w-khaanD", "type": "word", "gujarati": "ખાંડ", "translit": "khaanD", "english": "sugar", "notes": "Feminine: ખાંડ કેટલાની છે?" },
    { "id": "w-vadhaare", "type": "word", "gujarati": "વધારે", "translit": "vadhaare", "english": "more, too much", "notes": "The opposite of ઓછું. થોડું વધારે = a little more." },
    { "id": "w-vaagyaa", "type": "word", "gujarati": "વાગ્યા", "translit": "vaagyaa", "english": "o'clock", "notes": "Literally \"(the hours) have struck\". One o'clock is singular: એક વાગ્યો." },
    { "id": "w-saaDaa", "type": "word", "gujarati": "સાડા", "translit": "saaDaa", "english": "half past", "notes": "Used from 3 up: સાડા ત્રણ = 3:30. Half past one is દોઢ and half past two is અઢી." },
    { "id": "x-what-time-is-it", "type": "sentence", "gujarati": "કેટલા વાગ્યા છે?", "translit": "keTlaa vaagyaa chhe?", "english": "What time is it?", "notes": "Literally \"how many have struck?\"" },
    { "id": "x-half-past-three", "type": "sentence", "gujarati": "સાડા ત્રણ વાગ્યા છે.", "translit": "saaDaa traN vaagyaa chhe.", "english": "It is half past three.", "alts": ["It's half past three", "It is three thirty", "It's three thirty"] },

    { "id": "x-kilo-of-sugar", "type": "sentence", "gujarati": "એક કિલો ખાંડ કેટલાની છે?", "translit": "ek kilo khaanD keTlaanee chhe?", "english": "How much is a kilo of sugar?", "alts": ["How much is one kilo of sugar"], "notes": "કેટલાની, not કેટલાનું: ખાંડ is feminine." },

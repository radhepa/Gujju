    { "id": "w-pandar", "type": "word", "gujarati": "પંદર", "translit": "pandar", "english": "fifteen", "notes": "In digits: ૧૫." },
    { "id": "w-roopiyaa", "type": "word", "gujarati": "રૂપિયા", "translit": "roopiyaa", "english": "rupees", "notes": "One rupee is એક રૂપિયો. Prices are said with the number first: દસ રૂપિયા." },
    { "id": "x-tea-twelve-rupees", "type": "sentence", "gujarati": "ચા બાર રૂપિયાની છે.", "translit": "chaa baar roopiyaanee chhe.", "english": "The tea is twelve rupees.", "alts": ["Tea is twelve rupees", "The tea is 12 rupees", "Tea is 12 rupees", "The tea costs twelve rupees"], "notes": "Literally \"the tea is of twelve rupees\". ની matches ચા, which is feminine." },

    { "id": "w-soL", "type": "word", "gujarati": "સોળ", "translit": "soL", "english": "sixteen", "notes": "In digits: ૧૬." },

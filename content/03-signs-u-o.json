{
  "id": "s03",
  "order": 3,
  "title": "Signs for u, oo and o",
  "goal": "Read ગુજરાત, ઘી, દૂધ and ફોન, and tell ઘ from ધ.",
  "tip": "ુ (u) and ૂ (oo) hang under the letter, and ો (o) is ા with a stroke on top. Many letters come in pairs, plain and breathy: ગ ga and ઘ gha, બ ba and ભ bha. The breathy one has an h after it in the transliteration.",
  "lessons": [
    { "id": "s03-l1", "title": "ુ and ઉ", "items": ["l-u", "s-ku", "l-ga", "l-ba", "w-gujaraat", "w-gulaab", "w-bas"] },
    { "id": "s03-l2", "title": "ૂ and ઊ", "items": ["l-oo", "s-koo", "l-kha", "l-gha", "w-khoob", "w-ghee", "w-ghar"] },
    { "id": "s03-l3", "title": "ો and ઓ", "items": ["l-o", "s-ko", "l-dha", "l-tha", "w-doodh", "w-loko", "w-methee"] },
    { "id": "s03-l4", "title": "ભ and ફ", "items": ["l-bha", "l-pha", "w-bhaakhree", "w-phool", "w-phon", "w-kheer"] },
    { "id": "s03-l5", "title": "Lookalikes", "items": [], "review": true }
  ],
  "items": [

    { "id": "x-twenty-two-rupees", "type": "sentence", "gujarati": "ચા બાવીસ રૂપિયાની છે.", "translit": "chaa baavees roopiyaanee chhe.", "english": "The tea is twenty-two rupees.", "alts": ["Tea is twenty-two rupees", "The tea costs twenty-two rupees"] },


{
  "id": "u18",
  "order": 18,
  "title": "Can, must, want",
  "tip": "Wanting, liking and having to put the person in the ને or એ form: મને ચા ગમે છે (I like tea), મારે પાણી જોઈએ છે (I want water), મારે જવું પડશે (I'll have to go).",
  "lessons": [
    { "id": "u18-l1", "title": "I can", "items": ["w-shakvun", "w-tarvun", "w-gaavun", "w-ramvun", "x-i-can-swim", "x-meera-can-sing", "x-can-you-come-tomorrow"], "translit": "hint" },
    { "id": "u18-l2", "title": "I have to", "items": ["w-paDvun", "w-maare", "w-tamaare", "w-kaam", "w-roj", "x-i-have-to-go", "x-work-every-day"], "translit": "hide" },
    { "id": "u18-l3", "title": "I want, I need", "items": ["w-joiye", "w-madad", "w-samay", "w-navun", "x-i-want-water", "x-what-do-you-want", "x-i-need-help"], "translit": "hide" },
    { "id": "u18-l4", "title": "I like, I know", "items": ["w-gamvun", "w-aavaDvun", "w-khabar", "w-tamne", "x-i-like-tea", "x-i-know-gujarati", "x-i-dont-know"], "translit": "hide" },
    { "id": "u18-l5", "title": "Putting it together", "items": ["x-take-the-medicine", "x-dont-like-spicy", "x-do-you-know-swim", "x-want-to-learn-gujarati", "x-cant-come-today", "x-need-a-little-time"], "translit": "hide" }
  ],
  "items": [
    { "id": "w-shakvun", "type": "word", "gujarati": "શકવું", "translit": "shakvun", "english": "can, to be able to", "notes": "It follows the main verb's stem + ી: તરી શકું (can swim), વાંચી શકે (can read). After a vowel the ી is written ઈ: ગાઈ શકે (can sing)." },
    { "id": "w-tarvun", "type": "word", "gujarati": "તરવું", "translit": "tarvun", "english": "to swim" },
    { "id": "w-gaavun", "type": "word", "gujarati": "ગાવું", "translit": "gaavun", "english": "to sing" },
    { "id": "w-ramvun", "type": "word", "gujarati": "રમવું", "translit": "ramvun", "english": "to play" },
    { "id": "x-i-can-swim", "type": "sentence", "gujarati": "હું તરી શકું છું.", "translit": "hun taree shakun chhun.", "english": "I can swim." },
    { "id": "x-meera-can-sing", "type": "sentence", "gujarati": "મીરા ગાઈ શકે છે.", "translit": "meeraa gaai shake chhe.", "english": "Meera can sing." },
    { "id": "x-can-you-come-tomorrow", "type": "sentence", "gujarati": "તમે કાલે આવી શકશો?", "translit": "tame kaale aavee shaksho?", "english": "Can you come tomorrow?", "alts": ["Will you be able to come tomorrow", "Could you come tomorrow"], "notes": "શકશો is the future, \"will you be able to\". It's a softer way to ask." },

    { "id": "w-paDvun", "type": "word", "gujarati": "પડવું", "translit": "paDvun", "english": "to fall; to have to", "notes": "After a -વું verb it means \"have to\", and the person takes એ: મારે જવું પડશે, I'll have to go. Rain uses it too: વરસાદ પડે છે." },
    { "id": "w-maare", "type": "word", "gujarati": "મારે", "translit": "maare", "english": "for me (I have to, I want to)", "notes": "The એ form of હું, used for \"have to\", \"want to\" and \"need\"." },
    { "id": "w-tamaare", "type": "word", "gujarati": "તમારે", "translit": "tamaare", "english": "for you (you have to, you want to)", "notes": "The એ form of તમે: તમારે જવું પડશે, you'll have to go." },
    { "id": "w-kaam", "type": "word", "gujarati": "કામ", "translit": "kaam", "english": "work, job", "notes": "Neuter. To work is કામ કરવું." },
    { "id": "w-roj", "type": "word", "gujarati": "રોજ", "translit": "roj", "english": "every day" },
    { "id": "x-i-have-to-go", "type": "sentence", "gujarati": "મારે જવું પડશે.", "translit": "maare javun paDshe.", "english": "I will have to go.", "alts": ["I'll have to go", "I have to go", "I must go"] },
    { "id": "x-work-every-day", "type": "sentence", "gujarati": "મારે રોજ કામ કરવું પડે છે.", "translit": "maare roj kaam karvun paDe chhe.", "english": "I have to work every day.", "alts": ["Every day I have to work"], "notes": "પડે છે is the present: something you always have to do." },

    { "id": "w-joiye", "type": "word", "gujarati": "જોઈએ", "translit": "joiye", "english": "is needed, is wanted", "notes": "The thing you want is the subject and the person takes એ: મારે પાણી જોઈએ છે, I want water (literally \"for me water is needed\"). મને works too: મને પાણી જોઈએ છે." },
    { "id": "w-madad", "type": "word", "gujarati": "મદદ", "translit": "madad", "english": "help", "notes": "Feminine." },
    { "id": "w-samay", "type": "word", "gujarati": "સમય", "translit": "samay", "english": "time", "notes": "Masculine: થોડો સમય, a little time." },
    { "id": "w-navun", "type": "word", "gujarati": "નવું", "translit": "navun", "english": "new (neuter)", "notes": "It agrees like સારું: નવો, નવી, નવું, નવા." },
    { "id": "x-i-want-water", "type": "sentence", "gujarati": "મારે પાણી જોઈએ છે.", "translit": "maare paaNee joiye chhe.", "english": "I want water.", "alts": ["I need water", "I want some water", "I need some water"] },
    { "id": "x-what-do-you-want", "type": "sentence", "gujarati": "તમારે શું જોઈએ છે?", "translit": "tamaare shun joiye chhe?", "english": "What do you want?", "alts": ["What do you need", "What would you like"], "notes": "What a shopkeeper asks you." },
    { "id": "x-i-need-help", "type": "sentence", "gujarati": "મારે મદદ જોઈએ છે.", "translit": "maare madad joiye chhe.", "english": "I need help.", "alts": ["I want help"] },

    { "id": "w-gamvun", "type": "word", "gujarati": "ગમવું", "translit": "gamvun", "english": "to like (to be liked)", "notes": "The person who likes takes ને and the thing liked is the subject: મને ચા ગમે છે, I like tea (literally \"tea pleases me\")." },
    { "id": "w-aavaDvun", "type": "word", "gujarati": "આવડવું", "translit": "aavaDvun", "english": "to know how", "notes": "For skills, with ને: મને ગુજરાતી આવડે છે, I know Gujarati." },
    { "id": "w-khabar", "type": "word", "gujarati": "ખબર", "translit": "khabar", "english": "knowing, news", "notes": "For facts: મને ખબર છે, I know. મને ખબર નથી, I don't know." },
    { "id": "w-tamne", "type": "word", "gujarati": "તમને", "translit": "tamne", "english": "to you (polite)", "notes": "The ને form of તમે: તમને ગમે છે? Do you like it?" },
    { "id": "x-i-like-tea", "type": "sentence", "gujarati": "મને ચા ગમે છે.", "translit": "mane chaa game chhe.", "english": "I like tea." },
    { "id": "x-i-know-gujarati", "type": "sentence", "gujarati": "મને ગુજરાતી આવડે છે.", "translit": "mane gujaraatee aavDe chhe.", "english": "I know Gujarati.", "notes": "A skill you have learned, so it's આવડવું, not ખબર." },
    { "id": "x-i-dont-know", "type": "sentence", "gujarati": "મને ખબર નથી.", "translit": "mane khabar nathee.", "english": "I don't know.", "alts": ["I do not know"] },

    { "id": "x-take-the-medicine", "type": "sentence", "gujarati": "તમારે દવા લેવી પડશે.", "translit": "tamaare davaa levee paDshe.", "english": "You will have to take medicine.", "alts": ["You'll have to take medicine", "You will have to take the medicine", "You have to take medicine"], "notes": "દવા is feminine, so the -વું verb agrees with it: લેવી, not લેવું." },
    { "id": "x-dont-like-spicy", "type": "sentence", "gujarati": "મને તીખું નથી ગમતું.", "translit": "mane teekhun nathee gamtun.", "english": "I don't like spicy food.", "alts": ["I do not like spicy food", "I don't like spicy things"], "notes": "With નથી, ગમે becomes ગમતું (ગમતી for a feminine thing): મને ચા નથી ગમતી." },
    { "id": "x-do-you-know-swim", "type": "sentence", "gujarati": "તમને તરતાં આવડે છે?", "translit": "tamne tartaan aavDe chhe?", "english": "Do you know how to swim?", "alts": ["Can you swim"], "notes": "With આવડવું the verb takes -તાં: તરતાં, swimming." },
    { "id": "x-want-to-learn-gujarati", "type": "sentence", "gujarati": "મારે ગુજરાતી શીખવું છે.", "translit": "maare gujaraatee sheekhvun chhe.", "english": "I want to learn Gujarati.", "notes": "મારે + a -વું verb + છે means \"I want to\"." },
    { "id": "x-cant-come-today", "type": "sentence", "gujarati": "હું આજે નહીં આવી શકું.", "translit": "hun aaje naheen aavee shakun.", "english": "I won't be able to come today.", "alts": ["I will not be able to come today", "I can't come today", "I cannot come today", "Today I won't be able to come"], "notes": "નહીં, not નથી, because it looks ahead. You'll also hear it after the main verb: હું આજે આવી નહીં શકું." },
    { "id": "x-need-a-little-time", "type": "sentence", "gujarati": "મારે થોડો સમય જોઈએ છે.", "translit": "maare thoDo samay joiye chhe.", "english": "I need a little time.", "alts": ["I need some time", "I want a little time"], "notes": "સમય is masculine, so થોડું becomes થોડો." }
  ]
}

{
  "id": "everyday",
  "title": "Everyday Gujarati",
  "titleGu": "રોજની ગુજરાતી",
  "level": 1,
  "blurb": "Short sentences about family, food, home and the day, built on the words from the course.",
  "sentences": [
    {"id": "ev-001", "gu": "નમસ્તે, તમે કેમ છો?", "tr": "namaste, tame kem chho?", "en": "Hello, how are you?", "cloze": "છો", "wrong": ["છે", "છું", "છીએ"], "note": "તમે always takes છો."},
    {"id": "ev-002", "gu": "હું મજામાં છું, આભાર.", "tr": "hun majaamaan chhun, aabhaar.", "en": "I'm fine, thank you.", "cloze": "આભાર", "wrong": ["આવજો", "નમસ્તે", "ચાલો"]},
    {"id": "ev-003", "gu": "તમારો ખૂબ આભાર.", "tr": "tamaaro khoob aabhaar.", "en": "Thank you very much.", "cloze": "તમારો", "wrong": ["તમારું", "તમારી", "તમારા"], "note": "આભાર is masculine, so \"your\" takes the ો ending."},
    {"id": "ev-004", "gu": "માફ કરજો, મને ખબર નથી.", "tr": "maaph karjo, mane khabar nathee.", "en": "Sorry, I don't know.", "cloze": "નથી", "wrong": ["છું", "છો", "છીએ"], "note": "મને ખબર છે = I know; મને ખબર નથી = I don't know."},
    {"id": "ev-005", "gu": "આવજો, કાલે મળીએ.", "tr": "aavjo, kaale maLiye.", "en": "Bye, see you tomorrow.", "cloze": "કાલે", "wrong": ["આજે", "ગઈકાલે", "હમણાં"]},
    {"id": "ev-006", "gu": "જય શ્રી કૃષ્ણ, દાદા!", "tr": "jay shree krushNa, daadaa!", "en": "Jai Shri Krishna, Grandpa!", "cloze": "દાદા", "wrong": ["દાદી", "નાની", "માસી"], "note": "A warm greeting used with elders in many Gujarati families."},
    {"id": "ev-007", "gu": "કૃપા કરીને અંદર આવો.", "tr": "krupaa kareene andar aavo.", "en": "Please come in.", "cloze": "અંદર", "wrong": ["બહાર", "ઉપર", "નીચે"], "note": "કૃપા કરીને is the formal \"please\" of signs and announcements. At home people just say આવો, આવો!"},
    {"id": "ev-008", "gu": "મહેરબાની કરીને બેસો.", "tr": "maherbaanee kareene beso.", "en": "Please sit down.", "cloze": "બેસો", "wrong": ["બેસું", "બેસે", "બેઠો"], "note": "The તમે form of a verb (ending in ો) is also the polite way to ask someone to do something."},
    {"id": "ev-009", "gu": "મહેરબાની કરીને ધીમે બોલો.", "tr": "maherbaanee kareene dheeme bolo.", "en": "Please speak slowly.", "cloze": "ધીમે", "wrong": ["ઝડપથી", "જોરથી", "મોટેથી"], "note": "ધીમે can mean slowly or softly. ધીમે ધીમે makes it clearly \"slowly\"."},
    {"id": "ev-010", "gu": "હું ગુજરાતી સમજું છું.", "tr": "hun gujaraatee samjun chhun.", "en": "I understand Gujarati.", "cloze": "સમજું", "wrong": ["સમજે", "સમજો", "સમજીએ"]},
    {"id": "ev-011", "gu": "મને સમજાતું નથી.", "tr": "mane samjaatun nathee.", "en": "I don't understand.", "cloze": "મને", "wrong": ["હું", "તું", "અમે"], "note": "Literally \"it is not understood to me\", so it starts with મને, not હું."},
    {"id": "ev-012", "gu": "તમારા પપ્પાનું નામ શું છે?", "tr": "tamaaraa pappaanun naam shun chhe?", "en": "What is your dad's name?", "cloze": "પપ્પાનું", "wrong": ["પપ્પાની", "પપ્પાનો", "પપ્પાના"], "note": "નામ is neuter, so \"dad's\" is પપ્પાનું."},
    {"id": "ev-013", "gu": "મારી બહેનનું નામ મીરા છે.", "tr": "maaree bahennun naam meeraa chhe.", "en": "My sister's name is Meera.", "cloze": "નામ", "wrong": ["કામ", "ગામ", "નાક"]},
    {"id": "ev-014", "gu": "હા, હું આવું છું.", "tr": "haa, hun aavun chhun.", "en": "Yes, I'm coming.", "cloze": "આવું", "wrong": ["આવે", "આવો", "આવીએ"]},
    {"id": "ev-015", "gu": "ના, મને ચા નથી જોઈતી.", "tr": "naa, mane chaa nathee joitee.", "en": "No, I don't want tea.", "cloze": "જોઈતી", "wrong": ["જોઈતો", "જોઈતું", "જોઈતા"], "note": "In the negative, જોઈએ becomes જોઈતું / જોઈતી / જોઈતો to match the thing wanted. ચા is feminine."},
    {"id": "ev-016", "gu": "તમારું સ્વાગત છે!", "tr": "tamaarun svaagat chhe!", "en": "Welcome!", "cloze": "તમારું", "wrong": ["તમારી", "તમારો", "તમારા"], "note": "સ્વાગત is neuter."},
    {"id": "ev-017", "gu": "તમે ગુજરાતી બોલો છો?", "tr": "tame gujaraatee bolo chho?", "en": "Do you speak Gujarati?", "cloze": "બોલો", "wrong": ["બોલું", "બોલે", "બોલીએ"]},
    {"id": "ev-018", "gu": "હા, હું થોડું બોલું છું.", "tr": "haa, hun thoDun bolun chhun.", "en": "Yes, I speak a little.", "cloze": "હું", "wrong": ["તું", "તે", "અમે"]},
    {"id": "ev-019", "gu": "આ મારી મમ્મી છે.", "tr": "aa maaree mammee chhe.", "en": "This is my mom.", "cloze": "મમ્મી", "wrong": ["પપ્પા", "ભાઈ", "દીકરો"]},
    {"id": "ev-020", "gu": "મારા પપ્પા શિક્ષક છે.", "tr": "maaraa pappaa shikshak chhe.", "en": "My dad is a teacher.", "cloze": "મારા", "wrong": ["મારો", "મારી", "મારું"], "note": "Elders get the respectful plural: મારા પપ્પા, not મારો પપ્પા."},
    {"id": "ev-021", "gu": "મારે એક ભાઈ છે.", "tr": "maare ek bhaai chhe.", "en": "I have one brother.", "cloze": "ભાઈ", "wrong": ["બહેન", "દીકરી", "માસી"], "note": "મારે ... છે is how you say \"I have\" for relatives."},
    {"id": "ev-022", "gu": "મારે બે બહેનો છે.", "tr": "maare be baheno chhe.", "en": "I have two sisters.", "cloze": "બે", "wrong": ["એક", "ત્રણ", "ચાર"]},
    {"id": "ev-023", "gu": "અમે પાંચ જણ છીએ.", "tr": "ame paanch jaN chhiye.", "en": "There are five of us.", "cloze": "છીએ", "wrong": ["છે", "છો", "છું"], "note": "જણ is used when counting people."},
    {"id": "ev-024", "gu": "મારો ભાઈ ક્રિકેટ રમે છે.", "tr": "maaro bhaai krikeT rame chhe.", "en": "My brother plays cricket.", "cloze": "રમે", "wrong": ["રમું", "રમો", "રમીએ"]},
    {"id": "ev-025", "gu": "મારી બહેન ગીત ગાય છે.", "tr": "maaree bahen geet gaay chhe.", "en": "My sister is singing a song.", "cloze": "બહેન", "wrong": ["ભાઈ", "દીકરો", "મિત્ર"], "note": "મારી (feminine) needs a feminine word after it."},
    {"id": "ev-026", "gu": "મારા દાદા છાપું વાંચે છે.", "tr": "maaraa daadaa chhaapun vaanche chhe.", "en": "My grandfather reads the newspaper.", "cloze": "વાંચે", "wrong": ["વાંચું", "વાંચો", "વાંચીએ"]},
    {"id": "ev-027", "gu": "મારા કાકા મુંબઈમાં રહે છે.", "tr": "maaraa kaakaa mumbaimaan rahe chhe.", "en": "My uncle lives in Mumbai.", "cloze": "રહે", "wrong": ["રહું", "રહો", "રહીએ"], "note": "કાકા is your father's brother."},
    {"id": "ev-028", "gu": "તમારો દીકરો ક્યાં છે?", "tr": "tamaaro deekro kyaan chhe?", "en": "Where is your son?", "cloze": "તમારો", "wrong": ["તમારું", "તમારી", "તમારા"]},
    {"id": "ev-029", "gu": "તેની દીકરી ત્રણ વર્ષની છે.", "tr": "tenee deekree traN varshnee chhe.", "en": "Her daughter is three years old.", "cloze": "વર્ષની", "wrong": ["વર્ષનો", "વર્ષનું", "વર્ષના"], "note": "Age agrees with the person: a girl is ... વર્ષની, a boy ... વર્ષનો."},
    {"id": "ev-030", "gu": "અમારો પરિવાર મોટો છે.", "tr": "amaaro parivaar moTo chhe.", "en": "Our family is big.", "cloze": "મોટો", "wrong": ["મોટી", "મોટું", "મોટા"], "note": "પરિવાર is masculine."},
    {"id": "ev-031", "gu": "મામા કાલે આવે છે.", "tr": "maamaa kaale aave chhe.", "en": "Uncle is coming tomorrow.", "cloze": "આવે", "wrong": ["આવું", "આવો", "આવીએ"], "note": "મામા is your mother's brother. The present tense often covers the near future."},
    {"id": "ev-032", "gu": "બાળકો બહાર રમે છે.", "tr": "baaLko bahaar rame chhe.", "en": "The children are playing outside.", "cloze": "બહાર", "wrong": ["અંદર", "ઘરમાં", "ઉપર"]},
    {"id": "ev-033", "gu": "પેલી છોકરી કોણ છે?", "tr": "pelee chhokree koN chhe?", "en": "Who is that girl?", "cloze": "છોકરી", "wrong": ["છોકરો", "દીકરો", "માણસ"], "note": "પેલી (feminine) needs a feminine word after it."},
    {"id": "ev-034", "gu": "પેલો છોકરો મારો મિત્ર છે.", "tr": "pelo chhokro maaro mitra chhe.", "en": "That boy is my friend.", "cloze": "છોકરો", "wrong": ["છોકરી", "છોકરા", "છોકરાં"]},
    {"id": "ev-035", "gu": "પપ્પા રસોડામાં છે.", "tr": "pappaa rasoDaamaan chhe.", "en": "Dad is in the kitchen.", "cloze": "રસોડામાં", "wrong": ["રસોડું", "રસોડાનું", "રસોડાથી"], "note": "રસોડું + માં becomes રસોડામાં."},
    {"id": "ev-036", "gu": "તમારે કેટલાં બાળકો છે?", "tr": "tamaare keTlaan baaLko chhe?", "en": "How many children do you have?", "cloze": "કેટલાં", "wrong": ["કેટલો", "કેટલી", "કેટલું"], "note": "With a neuter plural word like બાળકો, કેટલું becomes કેટલાં."},
    {"id": "ev-037", "gu": "મારા દાદા અને દાદી ગામમાં રહે છે.", "tr": "maaraa daadaa ane daadee gaammaan rahe chhe.", "en": "My grandfather and grandmother live in the village.", "cloze": "ગામમાં", "wrong": ["ગામનું", "ગામને", "ગામથી"]},
    {"id": "ev-038", "gu": "મારો દીકરો નાનો છે.", "tr": "maaro deekro naano chhe.", "en": "My son is little.", "cloze": "નાનો", "wrong": ["નાની", "નાનું", "નાના"]},
    {"id": "ev-039", "gu": "દાદી અમને વાર્તા કહે છે.", "tr": "daadee amne vaartaa kahe chhe.", "en": "Grandma tells us a story.", "cloze": "કહે", "wrong": ["કહું", "કહો", "કહીએ"]},
    {"id": "ev-040", "gu": "બાળકો વાર્તા સાંભળે છે.", "tr": "baaLko vaartaa saambhLe chhe.", "en": "The children are listening to a story.", "cloze": "સાંભળે", "wrong": ["સાંભળું", "સાંભળો", "સાંભળીએ"]},
    {"id": "ev-041", "gu": "મારી મમ્મી સરસ રસોઈ બનાવે છે.", "tr": "maaree mammee saras rasoi banaave chhe.", "en": "My mom is a great cook.", "cloze": "બનાવે", "wrong": ["બનાવું", "બનાવો", "બનાવીએ"], "note": "Literally \"my mom makes nice cooking\"."},
    {"id": "ev-042", "gu": "મારા ભાઈની ગાડી લાલ છે.", "tr": "maaraa bhaainee gaaDee laal chhe.", "en": "My brother's car is red.", "cloze": "ભાઈની", "wrong": ["ભાઈનું", "ભાઈનો", "ભાઈના"], "note": "ગાડી is feminine, so \"brother's\" is ભાઈની."},
    {"id": "ev-043", "gu": "તારો ભાઈ ક્યાં છે?", "tr": "taaro bhaai kyaan chhe?", "en": "Where is your brother?", "cloze": "તારો", "wrong": ["તારું", "તારી", "તારા"]},
    {"id": "ev-044", "gu": "તમારા ઘરમાં કોણ કોણ છે?", "tr": "tamaaraa gharmaan koN koN chhe?", "en": "Who is in your family?", "cloze": "ઘરમાં", "wrong": ["ઘર", "ઘરનું", "ઘરને"], "note": "Saying કોણ twice asks for a list of people. Literally \"who-who is in your house?\""},
    {"id": "ev-045", "gu": "મારા દાદાને ચા ગમે છે.", "tr": "maaraa daadaane chaa game chhe.", "en": "My grandfather likes tea.", "cloze": "દાદાને", "wrong": ["દાદા", "દાદાનું", "દાદાની"], "note": "The person who likes something takes ને: દાદાને ગમે છે."},
    {"id": "ev-046", "gu": "મારી બહેનને ફૂલો ગમે છે.", "tr": "maaree bahenne phoolo game chhe.", "en": "My sister likes flowers.", "cloze": "બહેનને", "wrong": ["બહેન", "બહેનનું", "બહેનની"]},
    {"id": "ev-047", "gu": "તારી બહેન ક્યાં ભણે છે?", "tr": "taaree bahen kyaan bhaNe chhe?", "en": "Where does your sister study?", "cloze": "તારી", "wrong": ["તારો", "તારું", "તારા"]},
    {"id": "ev-048", "gu": "મારા ભાઈને રમવું ગમે છે.", "tr": "maaraa bhaaine ramvun game chhe.", "en": "My brother likes to play.", "cloze": "રમવું", "wrong": ["રમું", "રમે", "રમો"], "note": "Use the વું form for \"to do something\": રમવું ગમે છે."},
    {"id": "ev-049", "gu": "હું દૂધ પીઉં છું.", "tr": "hun doodh peeun chhun.", "en": "I drink milk.", "cloze": "પીઉં", "wrong": ["પીએ", "પીઓ", "પીવું"]},
    {"id": "ev-050", "gu": "મને દાળભાત ગમે છે.", "tr": "mane daaLbhaat game chhe.", "en": "I like dal and rice.", "cloze": "મને", "wrong": ["હું", "મારું", "મારો"], "note": "Likes are said \"to me it is pleasing\": મને ... ગમે છે."},
    {"id": "ev-051", "gu": "તમને ચા ગમે છે?", "tr": "tamne chaa game chhe?", "en": "Do you like tea?", "cloze": "ગમે", "wrong": ["ગમું", "ગમો", "ગમીએ"], "note": "ગમે stays the same whoever is doing the liking."},
    {"id": "ev-052", "gu": "મને કેરીનો રસ ગમે છે.", "tr": "mane kereeno ras game chhe.", "en": "I like mango pulp.", "cloze": "કેરીનો", "wrong": ["કેરીની", "કેરીનું", "કેરીના"], "note": "કેરીનો રસ is the famous Gujarati summer treat. રસ is masculine, so કેરીનો."},
    {"id": "ev-053", "gu": "મને દૂધ ગમતું નથી.", "tr": "mane doodh gamtun nathee.", "en": "I don't like milk.", "cloze": "ગમતું", "wrong": ["ગમતી", "ગમતો", "ગમતા"], "note": "In the negative, ગમે becomes ગમતું / ગમતી / ગમતો to match the thing liked. દૂધ is neuter."},
    {"id": "ev-054", "gu": "આ ચા ઠંડી છે.", "tr": "aa chaa ThanDee chhe.", "en": "This tea is cold.", "cloze": "ઠંડી", "wrong": ["ઠંડું", "ઠંડો", "ઠંડા"], "note": "ચા is feminine."},
    {"id": "ev-055", "gu": "ભાત સારો છે.", "tr": "bhaat saaro chhe.", "en": "The rice is good.", "cloze": "સારો", "wrong": ["સારી", "સારું", "સારાં"], "note": "ભાત is masculine."},
    {"id": "ev-056", "gu": "દાળ થોડી મીઠી છે.", "tr": "daaL thoDee meeThee chhe.", "en": "The dal is a little sweet.", "cloze": "મીઠી", "wrong": ["મીઠું", "મીઠો", "મીઠા"], "note": "દાળ is feminine. Gujarati dal is often a little sweet."},
    {"id": "ev-057", "gu": "બાળકને ભૂખ લાગી છે.", "tr": "baaLakne bhookh laagee chhe.", "en": "The baby is hungry.", "cloze": "ભૂખ", "wrong": ["તરસ", "ઠંડી", "ગરમી"], "note": "Literally \"hunger has struck the baby\". The person who is hungry takes ને."},
    {"id": "ev-058", "gu": "મને તરસ લાગી છે.", "tr": "mane taras laagee chhe.", "en": "I'm thirsty.", "cloze": "લાગી", "wrong": ["લાગ્યો", "લાગ્યું", "લાગ્યા"], "note": "તરસ is feminine, so લાગી."},
    {"id": "ev-059", "gu": "મને પાણી જોઈએ છે.", "tr": "mane paaNee joiye chhe.", "en": "I want water.", "cloze": "જોઈએ", "wrong": ["જોઉં", "જુએ", "જુઓ"], "note": "મને ... જોઈએ છે = I want / I need."},
    {"id": "ev-060", "gu": "મને બે રોટલી આપો.", "tr": "mane be roTlee aapo.", "en": "Give me two rotlis.", "cloze": "આપો", "wrong": ["આપું", "આપે", "આપીએ"]},
    {"id": "ev-061", "gu": "ચાલો, આપણે જમીએ.", "tr": "chaalo, aapNe jamiye.", "en": "Come on, let's eat.", "cloze": "જમીએ", "wrong": ["જમું", "જમે", "જમો"], "note": "આપણે is \"we\" including the person you are talking to."},
    {"id": "ev-062", "gu": "અમે સાથે જમીએ છીએ.", "tr": "ame saathe jamiye chhiye.", "en": "We eat together.", "cloze": "સાથે", "wrong": ["માટે", "પાસે", "વગર"]},
    {"id": "ev-063", "gu": "થાળીમાં રોટલી અને શાક છે.", "tr": "thaaLeemaan roTlee ane shaak chhe.", "en": "There is rotli and shaak on the plate.", "cloze": "થાળીમાં", "wrong": ["થાળીનું", "થાળીને", "થાળીથી"], "note": "Gujarati says \"in the thali\" where English says \"on the plate\"."},
    {"id": "ev-064", "gu": "આ શાક બહુ સારું છે.", "tr": "aa shaak bahu saarun chhe.", "en": "This curry is very good.", "cloze": "સારું", "wrong": ["સારી", "સારો", "સારા"], "note": "શાક is neuter."},
    {"id": "ev-065", "gu": "કેરી મીઠી છે.", "tr": "keree meeThee chhe.", "en": "The mango is sweet.", "cloze": "કેરી", "wrong": ["કેળું", "સફરજન", "ભાત"], "note": "મીઠી is feminine, and so is કેરી."},
    {"id": "ev-066", "gu": "કેળું પીળું છે.", "tr": "keLun peeLun chhe.", "en": "The banana is yellow.", "cloze": "પીળું", "wrong": ["પીળી", "પીળો", "પીળા"], "note": "કેળું is neuter."},
    {"id": "ev-067", "gu": "સફરજન લાલ છે.", "tr": "sapharjan laal chhe.", "en": "The apple is red.", "cloze": "લાલ", "wrong": ["પીળું", "લીલું", "કાળું"], "note": "લાલ never changes its ending."},
    {"id": "ev-068", "gu": "ગાય દૂધ આપે છે.", "tr": "gaay doodh aape chhe.", "en": "The cow gives milk.", "cloze": "દૂધ", "wrong": ["પાણી", "ચા", "શાક"]},
    {"id": "ev-069", "gu": "હું સવારે નાસ્તો કરું છું.", "tr": "hun savaare naasto karun chhun.", "en": "I eat breakfast in the morning.", "cloze": "સવારે", "wrong": ["રાત્રે", "બપોરે", "સાંજે"], "note": "Gujarati says \"do breakfast\": નાસ્તો કરવો."},
    {"id": "ev-070", "gu": "તમે શું ખાઓ છો?", "tr": "tame shun khaao chho?", "en": "What are you eating?", "cloze": "ખાઓ", "wrong": ["ખાઉં", "ખાય", "ખાઈએ"]},
    {"id": "ev-071", "gu": "અમે રોજ દાળભાત ખાઈએ છીએ.", "tr": "ame roj daaLbhaat khaaiye chhiye.", "en": "We eat dal and rice every day.", "cloze": "ખાઈએ", "wrong": ["ખાઉં", "ખાય", "ખાઓ"]},
    {"id": "ev-072", "gu": "દૂધમાં ખાંડ નથી.", "tr": "doodhmaan khaanD nathee.", "en": "There's no sugar in the milk.", "cloze": "દૂધમાં", "wrong": ["દૂધથી", "દૂધનું", "દૂધને"]},
    {"id": "ev-073", "gu": "તમને કેટલું દૂધ જોઈએ છે?", "tr": "tamne keTlun doodh joiye chhe?", "en": "How much milk do you want?", "cloze": "દૂધ", "wrong": ["ચા", "રોટલી", "ભાત"], "note": "કેટલું is neuter, so it fits દૂધ. Tea would be કેટલી ચા."},
    {"id": "ev-074", "gu": "મમ્મી બજારમાંથી શાક લાવે છે.", "tr": "mammee bajaarmaanthee shaak laave chhe.", "en": "Mom brings vegetables from the market.", "cloze": "બજારમાંથી", "wrong": ["બજારમાં", "બજારનું", "બજારને"], "note": "માંથી means \"from (inside)\"."},
    {"id": "ev-075", "gu": "અમારું ઘર નાનું પણ સુંદર છે.", "tr": "amaarun ghar naanun paN sundar chhe.", "en": "Our house is small but beautiful.", "cloze": "અમારું", "wrong": ["અમારી", "અમારો", "અમારા"]},
    {"id": "ev-076", "gu": "રસોડું ક્યાં છે?", "tr": "rasoDun kyaan chhe?", "en": "Where is the kitchen?", "cloze": "ક્યાં", "wrong": ["કોણ", "ક્યારે", "કેમ"]},
    {"id": "ev-077", "gu": "બારી ખુલ્લી છે.", "tr": "baaree khullee chhe.", "en": "The window is open.", "cloze": "ખુલ્લી", "wrong": ["ખુલ્લું", "ખુલ્લો", "ખુલ્લા"], "note": "બારી is feminine."},
    {"id": "ev-078", "gu": "બત્તી બંધ કરો.", "tr": "battee bandh karo.", "en": "Turn off the light.", "cloze": "બત્તી", "wrong": ["બારી", "ચોપડી", "દુકાન"], "note": "બંધ કરો = close / switch off."},
    {"id": "ev-079", "gu": "ચોપડી ટેબલ પર છે.", "tr": "chopDee Tebal par chhe.", "en": "The book is on the table.", "cloze": "પર", "wrong": ["નીચે", "પાસે", "પાછળ"]},
    {"id": "ev-080", "gu": "બિલાડી ખુરશીની નીચે છે.", "tr": "bilaaDee khursheenee neeche chhe.", "en": "The cat is under the chair.", "cloze": "ખુરશીની", "wrong": ["ખુરશીનું", "ખુરશીનો", "ખુરશીને"], "note": "નીચે (under) takes ની before it: ખુરશીની નીચે."},
    {"id": "ev-081", "gu": "મારો ઓરડો ઉપર છે.", "tr": "maaro orDo upar chhe.", "en": "My room is upstairs.", "cloze": "મારો", "wrong": ["મારી", "મારું", "મારા"], "note": "ઓરડો is masculine."},
    {"id": "ev-082", "gu": "ઘરમાં કોણ છે?", "tr": "gharmaan koN chhe?", "en": "Who is in the house?", "cloze": "કોણ", "wrong": ["ક્યારે", "કેમ", "ક્યાં"]},
    {"id": "ev-083", "gu": "અમારા ઘરમાં ચાર ઓરડા છે.", "tr": "amaaraa gharmaan chaar orDaa chhe.", "en": "Our house has four rooms.", "cloze": "અમારા", "wrong": ["અમારું", "અમારી", "અમારો"], "note": "Before માં, અમારું ઘર becomes અમારા ઘરમાં."},
    {"id": "ev-084", "gu": "બગીચામાં ફૂલો છે.", "tr": "bageechaamaan phoolo chhe.", "en": "There are flowers in the garden.", "cloze": "બગીચામાં", "wrong": ["બગીચો", "બગીચાનું", "બગીચાને"], "note": "બગીચો + માં becomes બગીચામાં."},
    {"id": "ev-085", "gu": "આ ખુરશી જૂની છે.", "tr": "aa khurshee joonee chhe.", "en": "This chair is old.", "cloze": "જૂની", "wrong": ["જૂનું", "જૂનો", "જૂના"], "note": "ખુરશી is feminine."},
    {"id": "ev-086", "gu": "મારી ગાડી નવી છે.", "tr": "maaree gaaDee navee chhe.", "en": "My car is new.", "cloze": "મારી", "wrong": ["મારું", "મારો", "મારા"]},
    {"id": "ev-087", "gu": "અમે રાત્રે ટીવી જોઈએ છીએ.", "tr": "ame raatre Teevee joiye chhiye.", "en": "We watch TV at night.", "cloze": "જોઈએ", "wrong": ["જોઉં", "જુએ", "જુઓ"], "note": "Here જોઈએ is \"we watch\", from જોવું. It looks the same as જોઈએ \"need\"."},
    {"id": "ev-088", "gu": "પેલું ઘર મોટું છે.", "tr": "pelun ghar moTun chhe.", "en": "That house is big.", "cloze": "પેલું", "wrong": ["પેલી", "પેલો", "પેલા"], "note": "પેલું is \"that one over there\". ઘર is neuter."},
    {"id": "ev-089", "gu": "ઘરની બહાર એક ઝાડ છે.", "tr": "gharnee bahaar ek jhaaD chhe.", "en": "There is a tree outside the house.", "cloze": "ઘરની", "wrong": ["ઘરનું", "ઘરનો", "ઘરના"], "note": "બહાર (outside) takes ની before it: ઘરની બહાર."},
    {"id": "ev-090", "gu": "દરવાજા પર કોણ છે?", "tr": "darvaajaa par koN chhe?", "en": "Who is at the door?", "cloze": "દરવાજા", "wrong": ["દરવાજો", "દરવાજાનું", "દરવાજાને"], "note": "દરવાજો changes to દરવાજા before પર."},
    {"id": "ev-091", "gu": "શું દુકાન ખુલ્લી છે?", "tr": "shun dukaan khullee chhe?", "en": "Is the shop open?", "cloze": "દુકાન", "wrong": ["ઘર", "મંદિર", "રસોડું"], "note": "શું at the start turns a sentence into a yes/no question. દુકાન is feminine, so ખુલ્લી."},
    {"id": "ev-092", "gu": "તમારું ઘર ક્યાં છે?", "tr": "tamaarun ghar kyaan chhe?", "en": "Where is your house?", "cloze": "ક્યાં", "wrong": ["કોણ", "કેમ", "કેટલું"]},
    {"id": "ev-093", "gu": "તમે અહીં બેસો.", "tr": "tame aheen beso.", "en": "Please sit here.", "cloze": "અહીં", "wrong": ["ત્યાં", "ક્યાં", "અહીંથી"]},
    {"id": "ev-094", "gu": "દાદાનું માથું દુખે છે.", "tr": "daadaanun maathun dukhe chhe.", "en": "Grandpa has a headache.", "cloze": "દુખે", "wrong": ["દુખું", "દુખો", "દુખીએ"]},
    {"id": "ev-095", "gu": "મારો પગ દુખે છે.", "tr": "maaro pag dukhe chhe.", "en": "My leg hurts.", "cloze": "મારો", "wrong": ["મારી", "મારું", "મારે"], "note": "પગ is masculine."},
    {"id": "ev-096", "gu": "તેની આંખો મોટી છે.", "tr": "tenee aankho moTee chhe.", "en": "Her eyes are big.", "cloze": "મોટી", "wrong": ["મોટો", "મોટું", "મોટાં"], "note": "આંખ is feminine, and feminine plurals keep the ી ending: મોટી આંખો."},
    {"id": "ev-097", "gu": "બાળકના વાળ કાળા છે.", "tr": "baaLaknaa vaaL kaaLaa chhe.", "en": "The child's hair is black.", "cloze": "કાળા", "wrong": ["કાળો", "કાળી", "કાળું"], "note": "વાળ (hair) is masculine plural in Gujarati."},
    {"id": "ev-098", "gu": "હું હાથ ધોઉં છું.", "tr": "hun haath dhoun chhun.", "en": "I am washing my hands.", "cloze": "હાથ", "wrong": ["પગ", "વાળ", "દાંત"]},
    {"id": "ev-099", "gu": "હું દાંત સાફ કરું છું.", "tr": "hun daant saaph karun chhun.", "en": "I brush my teeth.", "cloze": "કરું", "wrong": ["કરે", "કરો", "કરીએ"], "note": "Literally \"I clean my teeth\"."},
    {"id": "ev-100", "gu": "તેનું નાક નાનું છે.", "tr": "tenun naak naanun chhe.", "en": "His nose is small.", "cloze": "તેનું", "wrong": ["તેની", "તેનો", "તેના"], "note": "નાક is neuter."},
    {"id": "ev-101", "gu": "એક હાથમાં પાંચ આંગળીઓ છે.", "tr": "ek haathmaan paanch aangLeeo chhe.", "en": "A hand has five fingers.", "cloze": "પાંચ", "wrong": ["ચાર", "છ", "દસ"]},
    {"id": "ev-102", "gu": "તે છોકરો ઊંચો છે.", "tr": "te chhokro ooncho chhe.", "en": "That boy is tall.", "cloze": "ઊંચો", "wrong": ["ઊંચી", "ઊંચું", "ઊંચા"]},
    {"id": "ev-103", "gu": "તેના હાથ ગંદા છે.", "tr": "tenaa haath gandaa chhe.", "en": "His hands are dirty.", "cloze": "ગંદા", "wrong": ["ગંદો", "ગંદી", "ગંદું"], "note": "હાથ is masculine; the plural adjective ends in ા."},
    {"id": "ev-104", "gu": "આકાશ વાદળી છે.", "tr": "aakaash vaadLee chhe.", "en": "The sky is blue.", "cloze": "વાદળી", "wrong": ["લીલું", "પીળું", "લાલ"]},
    {"id": "ev-105", "gu": "ઘાસ લીલું છે.", "tr": "ghaas leelun chhe.", "en": "The grass is green.", "cloze": "લીલું", "wrong": ["લીલી", "લીલો", "લીલા"], "note": "ઘાસ is neuter."},
    {"id": "ev-106", "gu": "તેની બિલાડી કાળી છે.", "tr": "tenee bilaaDee kaaLee chhe.", "en": "Her cat is black.", "cloze": "બિલાડી", "wrong": ["કૂતરો", "પોપટ", "ઘોડો"], "note": "તેની and કાળી are feminine, so the animal must be too."},
    {"id": "ev-107", "gu": "દૂધ સફેદ છે.", "tr": "doodh saphed chhe.", "en": "Milk is white.", "cloze": "સફેદ", "wrong": ["કાળું", "લાલ", "લીલું"], "note": "સફેદ never changes its ending."},
    {"id": "ev-108", "gu": "તને કયો રંગ ગમે છે?", "tr": "tane kayo rang game chhe?", "en": "Which colour do you like?", "cloze": "કયો", "wrong": ["કયું", "કોણ", "ક્યાં"], "note": "રંગ is masculine, so \"which\" is કયો."},
    {"id": "ev-109", "gu": "મારું મનપસંદ ફળ કેરી છે.", "tr": "maarun manpasand phaL keree chhe.", "en": "My favourite fruit is mango.", "cloze": "ફળ", "wrong": ["ફૂલ", "રંગ", "ગીત"]},
    {"id": "ev-110", "gu": "પોપટ લીલો છે.", "tr": "popaT leelo chhe.", "en": "The parrot is green.", "cloze": "પોપટ", "wrong": ["બિલાડી", "ગાય", "કેરી"], "note": "લીલો is masculine, so the noun must be too."},
    {"id": "ev-111", "gu": "કેટલા વાગ્યા છે?", "tr": "keTlaa vaagyaa chhe?", "en": "What time is it?", "cloze": "કેટલા", "wrong": ["કેટલું", "કેટલી", "કેટલો"]},
    {"id": "ev-112", "gu": "છ વાગ્યા છે.", "tr": "chha vaagyaa chhe.", "en": "It's six o'clock.", "cloze": "વાગ્યા", "wrong": ["વાગ્યો", "વાગ્યું", "વાગ્યે"], "note": "One o'clock is એક વાગ્યો છે; for other hours it is વાગ્યા."},
    {"id": "ev-113", "gu": "હું સાત વાગ્યે ઊઠું છું.", "tr": "hun saat vaagye ooThun chhun.", "en": "I get up at seven.", "cloze": "ઊઠું", "wrong": ["ઊઠે", "ઊઠો", "ઊઠીએ"], "note": "વાગ્યે = at ... o'clock."},
    {"id": "ev-114", "gu": "શાળા નવ વાગ્યે શરૂ થાય છે.", "tr": "shaaLaa nav vaagye sharoo thaay chhe.", "en": "School starts at nine.", "cloze": "થાય", "wrong": ["થાઉં", "થાઓ", "થઈએ"]},
    {"id": "ev-115", "gu": "અમે આઠ વાગ્યે જમીએ છીએ.", "tr": "ame aaTh vaagye jamiye chhiye.", "en": "We have dinner at eight.", "cloze": "અમે", "wrong": ["હું", "તું", "તે"], "note": "જમીએ છીએ only goes with અમે or આપણે."},
    {"id": "ev-116", "gu": "આજે સોમવાર છે.", "tr": "aaje somvaar chhe.", "en": "Today is Monday.", "cloze": "સોમવાર", "wrong": ["મંગળવાર", "રવિવાર", "શનિવાર"]},
    {"id": "ev-117", "gu": "આજે કયો વાર છે?", "tr": "aaje kayo vaar chhe?", "en": "What day is it today?", "cloze": "છે", "wrong": ["છું", "છો", "છીએ"]},
    {"id": "ev-118", "gu": "રવિવારે અમે મંદિર જઈએ છીએ.", "tr": "ravivaare ame mandir jaiye chhiye.", "en": "On Sundays we go to the temple.", "cloze": "જઈએ", "wrong": ["જાઉં", "જાય", "જાઓ"], "note": "રવિવાર + એ = on Sunday."},
    {"id": "ev-119", "gu": "શનિવારે હું ક્રિકેટ રમું છું.", "tr": "shanivaare hun krikeT ramun chhun.", "en": "On Saturdays I play cricket.", "cloze": "હું", "wrong": ["તું", "તે", "અમે"]},
    {"id": "ev-120", "gu": "ગુરુવારે મારો જન્મદિવસ છે.", "tr": "guruvaare maaro janmadivas chhe.", "en": "My birthday is on Thursday.", "cloze": "મારો", "wrong": ["મારી", "મારું", "મારા"], "note": "જન્મદિવસ is masculine."},
    {"id": "ev-121", "gu": "અમારા વર્ગમાં દસ છોકરીઓ છે.", "tr": "amaaraa vargmaan das chhokreeo chhe.", "en": "There are ten girls in our class.", "cloze": "વર્ગમાં", "wrong": ["વર્ગ", "વર્ગનું", "વર્ગને"], "note": "વર્ગ + માં = in the class."},
    {"id": "ev-122", "gu": "મારી પાસે એક બિલાડી છે.", "tr": "maaree paase ek bilaaDee chhe.", "en": "I have a cat.", "cloze": "મારી", "wrong": ["મારો", "મારું", "મારે"], "note": "મારી પાસે ... છે = I have (things and pets). For relatives, use મારે."},
    {"id": "ev-123", "gu": "તમારી ઉંમર કેટલી છે?", "tr": "tamaaree unmar keTlee chhe?", "en": "How old are you?", "cloze": "કેટલી", "wrong": ["કેટલું", "કેટલો", "કેટલા"], "note": "ઉંમર (age) is feminine."},
    {"id": "ev-124", "gu": "હું દસ વાગ્યે સૂઈ જાઉં છું.", "tr": "hun das vaagye sooi jaaun chhun.", "en": "I go to sleep at ten.", "cloze": "જાઉં", "wrong": ["જાય", "જાઓ", "જઈએ"]},
    {"id": "ev-125", "gu": "બસ ક્યારે આવે છે?", "tr": "bas kyaare aave chhe?", "en": "When does the bus come?", "cloze": "ક્યારે", "wrong": ["કોણ", "કેટલું", "શું"]},
    {"id": "ev-126", "gu": "બસ મોડી છે.", "tr": "bas moDee chhe.", "en": "The bus is late.", "cloze": "મોડી", "wrong": ["મોડું", "મોડો", "મોડા"], "note": "બસ is feminine."},
    {"id": "ev-127", "gu": "બે અને બે ચાર થાય.", "tr": "be ane be chaar thaay.", "en": "Two and two make four.", "cloze": "ચાર", "wrong": ["ત્રણ", "પાંચ", "છ"]},
    {"id": "ev-128", "gu": "નવ પછી દસ આવે છે.", "tr": "nav pachhee das aave chhe.", "en": "Ten comes after nine.", "cloze": "પછી", "wrong": ["પહેલાં", "સાથે", "માટે"]},
    {"id": "ev-129", "gu": "ટેબલ પર ત્રણ ચોપડીઓ છે.", "tr": "Tebal par traN chopDeeo chhe.", "en": "There are three books on the table.", "cloze": "ત્રણ", "wrong": ["બે", "ચાર", "પાંચ"]},
    {"id": "ev-130", "gu": "તમે કયા શહેરમાં રહો છો?", "tr": "tame kayaa shahermaan raho chho?", "en": "Which city do you live in?", "cloze": "રહો", "wrong": ["રહું", "રહે", "રહીએ"], "note": "Before માં, કયું becomes કયા: કયા શહેરમાં."},
    {"id": "ev-131", "gu": "તમે શું કામ કરો છો?", "tr": "tame shun kaam karo chho?", "en": "What work do you do?", "cloze": "કરો", "wrong": ["કરું", "કરે", "કરીએ"]},
    {"id": "ev-132", "gu": "તું કેમ રડે છે?", "tr": "tun kem raDe chhe?", "en": "Why are you crying?", "cloze": "રડે", "wrong": ["રડું", "રડો", "રડીએ"], "note": "With તું, the verb ends in એ, just like with તે."},
    {"id": "ev-133", "gu": "તમે ક્યારે ઊઠો છો?", "tr": "tame kyaare ooTho chho?", "en": "When do you get up?", "cloze": "તમે", "wrong": ["હું", "તું", "તે"]},
    {"id": "ev-134", "gu": "મારું ઘર અહીંથી દૂર છે.", "tr": "maarun ghar aheenthee door chhe.", "en": "My house is far from here.", "cloze": "દૂર", "wrong": ["નજીક", "પાસે", "ઉપર"]},
    {"id": "ev-135", "gu": "તે ક્યાં જાય છે?", "tr": "te kyaan jaay chhe?", "en": "Where is he going?", "cloze": "જાય", "wrong": ["જાઉં", "જાઓ", "જઈએ"]},
    {"id": "ev-136", "gu": "તમે ક્યારે આવો છો?", "tr": "tame kyaare aavo chho?", "en": "When are you coming?", "cloze": "આવો", "wrong": ["આવું", "આવે", "આવીએ"]},
    {"id": "ev-137", "gu": "આ કોની ચોપડી છે?", "tr": "aa konee chopDee chhe?", "en": "Whose book is this?", "cloze": "કોની", "wrong": ["કોનું", "કોનો", "કોના"], "note": "ચોપડી is feminine, so \"whose\" is કોની."},
    {"id": "ev-138", "gu": "આ પુસ્તક મારું છે.", "tr": "aa pustak maarun chhe.", "en": "This book is mine.", "cloze": "મારું", "wrong": ["મારી", "મારો", "મારા"], "note": "પુસ્તક is neuter. (ચોપડી, another word for book, is feminine.)"},
    {"id": "ev-139", "gu": "આ ચા તમારા માટે છે.", "tr": "aa chaa tamaaraa maaTe chhe.", "en": "This tea is for you.", "cloze": "તમારા", "wrong": ["તમારું", "તમારી", "તમારો"], "note": "Before માટે (for), use તમારા."},
    {"id": "ev-140", "gu": "તેને ક્રિકેટ ગમે છે.", "tr": "tene krikeT game chhe.", "en": "He likes cricket.", "cloze": "તેને", "wrong": ["તે", "તેનું", "તેની"]},
    {"id": "ev-141", "gu": "અમને ગરબા ગમે છે.", "tr": "amne garbaa game chhe.", "en": "We like garba.", "cloze": "અમને", "wrong": ["અમે", "અમારું", "અમારા"], "note": "ગરબા is the Gujarati circle dance, danced at Navratri."},
    {"id": "ev-142", "gu": "તમને શું ગમે છે?", "tr": "tamne shun game chhe?", "en": "What do you like?", "cloze": "તમને", "wrong": ["તમે", "તમારું", "તમારો"]},
    {"id": "ev-143", "gu": "બહાર વરસાદ પડે છે.", "tr": "bahaar varsaad paDe chhe.", "en": "It's raining outside.", "cloze": "પડે", "wrong": ["પડું", "પડો", "પડીએ"], "note": "Literally \"rain falls outside\"."},
    {"id": "ev-144", "gu": "બહાર બહુ ગરમી છે.", "tr": "bahaar bahu garmee chhe.", "en": "It's very hot outside.", "cloze": "ગરમી", "wrong": ["ઠંડી", "વરસાદ", "તરસ"]},
    {"id": "ev-145", "gu": "કૂતરો ભસે છે.", "tr": "kootro bhase chhe.", "en": "The dog is barking.", "cloze": "ભસે", "wrong": ["ભસું", "ભસો", "ભસીએ"]},
    {"id": "ev-146", "gu": "બિલાડી દૂધ પીએ છે.", "tr": "bilaaDee doodh piye chhe.", "en": "The cat is drinking milk.", "cloze": "પીએ", "wrong": ["પીઉં", "પીઓ", "પીવું"]},
    {"id": "ev-147", "gu": "બાળક ઊંઘે છે.", "tr": "baaLak oonghe chhe.", "en": "The baby is sleeping.", "cloze": "ઊંઘે", "wrong": ["ઊંઘું", "ઊંઘો", "ઊંઘીએ"]},
    {"id": "ev-148", "gu": "તે શાળામાં ભણે છે.", "tr": "te shaaLaamaan bhaNe chhe.", "en": "She studies at school.", "cloze": "શાળામાં", "wrong": ["શાળા", "શાળાનું", "શાળાને"]},
    {"id": "ev-149", "gu": "મારા પપ્પા દુકાનમાં કામ કરે છે.", "tr": "maaraa pappaa dukaanmaan kaam kare chhe.", "en": "My dad works in a shop.", "cloze": "કરે", "wrong": ["કરું", "કરો", "કરીએ"], "note": "Even with respectful મારા પપ્પા, the verb is કરે છે."},
    {"id": "ev-150", "gu": "મમ્મી સવારે પૂજા કરે છે.", "tr": "mammee savaare poojaa kare chhe.", "en": "Mom does puja in the morning.", "cloze": "સવારે", "wrong": ["સવાર", "સવારનું", "સવારનો"], "note": "સવાર + એ = in the morning."},
    {"id": "ev-151", "gu": "અમે રોજ ગુજરાતી શીખીએ છીએ.", "tr": "ame roj gujaraatee sheekhiye chhiye.", "en": "We learn Gujarati every day.", "cloze": "શીખીએ", "wrong": ["શીખું", "શીખે", "શીખો"]},
    {"id": "ev-152", "gu": "હું એક પત્ર લખું છું.", "tr": "hun ek patra lakhun chhun.", "en": "I am writing a letter.", "cloze": "લખું", "wrong": ["લખે", "લખો", "લખીએ"]},
    {"id": "ev-153", "gu": "તમે કયું પુસ્તક વાંચો છો?", "tr": "tame kayun pustak vaancho chho?", "en": "Which book are you reading?", "cloze": "કયું", "wrong": ["કયો", "કોણ", "ક્યાં"], "note": "પુસ્તક is neuter, so \"which\" is કયું."},
    {"id": "ev-154", "gu": "આજે હું બહુ ખુશ છું.", "tr": "aaje hun bahu khush chhun.", "en": "I'm very happy today.", "cloze": "છું", "wrong": ["છે", "છો", "છીએ"]},
    {"id": "ev-155", "gu": "તે ઘરે નથી.", "tr": "te ghare nathee.", "en": "He isn't at home.", "cloze": "ઘરે", "wrong": ["ઘરને", "ઘરથી", "ઘરેથી"], "note": "નથી is \"is not\" for every person: હું નથી, તમે નથી, તે નથી."},
    {"id": "ev-156", "gu": "હું બસમાં જાઉં છું.", "tr": "hun basmaan jaaun chhun.", "en": "I go by bus.", "cloze": "બસમાં", "wrong": ["બસનું", "બસને", "બસની"], "note": "Gujarati says \"in the bus\" for \"by bus\"."},
    {"id": "ev-157", "gu": "અમારું ગામ નાનું છે.", "tr": "amaarun gaam naanun chhe.", "en": "Our village is small.", "cloze": "નાનું", "wrong": ["નાની", "નાનો", "નાના"], "note": "ગામ is neuter."},
    {"id": "ev-158", "gu": "શહેરમાં બહુ ગાડીઓ છે.", "tr": "shahermaan bahu gaaDeeo chhe.", "en": "There are lots of cars in the city.", "cloze": "શહેરમાં", "wrong": ["શહેર", "શહેરનું", "શહેરને"]},
    {"id": "ev-159", "gu": "મને ચાલવું ગમે છે.", "tr": "mane chaalvun game chhe.", "en": "I like walking.", "cloze": "ચાલવું", "wrong": ["ચાલું", "ચાલે", "ચાલો"]},
    {"id": "ev-160", "gu": "હું રોજ સવારે ચાલવા જાઉં છું.", "tr": "hun roj savaare chaalvaa jaaun chhun.", "en": "I go for a walk every morning.", "cloze": "ચાલવા", "wrong": ["ચાલવું", "ચાલે", "ચાલું"], "note": "ચાલવા જવું = to go for a walk."},
    {"id": "ev-161", "gu": "આપણે ક્યાં જઈએ છીએ?", "tr": "aapNe kyaan jaiye chhiye?", "en": "Where are we going?", "cloze": "આપણે", "wrong": ["હું", "તું", "તે"]},
    {"id": "ev-162", "gu": "તેઓ ગુજરાતી બોલે છે.", "tr": "teo gujaraatee bole chhe.", "en": "They speak Gujarati.", "cloze": "બોલે", "wrong": ["બોલું", "બોલો", "બોલીએ"]},
    {"id": "ev-163", "gu": "મને ડર લાગે છે.", "tr": "mane Dar laage chhe.", "en": "I'm scared.", "cloze": "ડર", "wrong": ["ભૂખ", "તરસ", "ઠંડી"], "note": "Literally \"fear is felt by me\"."}
  ]
}
